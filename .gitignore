.mcp.json
.DS_Store
*.bak

# The test suite IS tracked — it is the project's correctness contract.
# (It is excluded from the npm tarball via .npmignore, not from git.)
# Only engine-generated artifacts below are ignored.

# Godot editor caches and import artifacts (never commit these)
.godot/
test/test-project/.godot/
test/test-project/**/*.uid
test/test-project/**/*.import

# Addon copy inside the test project — regenerated by `npm run build` (sync-addons)
test/test-project/addons/

# Scratch files the test suite writes into the test project (`_t*` naming convention)
test/test-project/**/_t*
test/test-project/scenes/hurricane.*
